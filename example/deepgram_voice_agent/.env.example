# Required
DEEPGRAM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:18789/v1

# Optional. Omit when the endpoint selects its own model.
LLM_MODEL=

# Optional. Leave empty when the local endpoint does not require a key.
LLM_API_KEY=

# Server
VOICE_SERVER_HOST=127.0.0.1
VOICE_SERVER_PORT=8765

# Models and behavior
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_LANGUAGE=en-US
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Keep responses brief and conversational. Your response will be spoken aloud. Use plain text only. Do not use Markdown, headings, bullets, numbered lists, code blocks, URLs, brackets, or formatting symbols. Write lists as natural spoken sentences.
